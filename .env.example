# Pre-revenue spending guard: hosted paid AI/research services are disabled by default.
# Do not set this to 1 until Jerry has verified revenue and the owner explicitly approves paid usage.
JERRY_PAID_SERVICES_ENABLED=0

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional real Firebase authentication/revocation release gate.
# Enable only against a disposable/dedicated Firebase test account/project.
JERRY_FIREBASE_INTEGRATION=0
JERRY_FIREBASE_PROJECT_ID=
JERRY_FIREBASE_WEB_API_KEY=
JERRY_FIREBASE_TEST_EMAIL=
JERRY_FIREBASE_TEST_PASSWORD=

# Mandatory owner-configured daily ceiling for all hosted model-provider attempts.
# Set a positive integer based on an explicit token allowance; no USD pricing is assumed.
# Every fallback attempt reserves its own conservative token upper bound.
JERRY_DAILY_PROVIDER_TOKEN_LIMIT=

# Shared per-owner daily cap for all multimodal and direct SDK provider attempts.
# Fallback attempts each consume one operation. This is a request ceiling, not a USD price.
JERRY_DAILY_PROVIDER_OPERATION_LIMIT=

# Optional hard daily token-priced text-generation cost ceiling, in integer micro-USD (1 USD = 1,000,000 micro-USD).
# Applies to providerAdapters text generation and the three direct Gemini SDK generation routes.
# It does NOT include image/audio model charges, Google Search grounding, Tavily research, or other non-token fees.
# Those external operations remain request-count limited but are not yet covered by this USD ceiling.
# Per-model rates must be explicitly supplied; no provider prices are assumed by Jerry.
# JSON keys are exact "provider/model" names; rates are micro-USD per 1,000,000 tokens.
# Example shape only (replace with current verified provider pricing before enabling):
JERRY_PROVIDER_MODEL_PRICING_JSON=
JERRY_DAILY_PROVIDER_COST_LIMIT_MICRO_USD=
