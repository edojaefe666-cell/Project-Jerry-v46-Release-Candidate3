# Neon PostgreSQL connection. Keep this value in the server secret manager only.
# Neon connection strings should include sslmode=require.
DATABASE_URL=

# Direct Neon endpoint used only by schema migrations. Keep it server-side.
# Set this separately from the pooled DATABASE_URL used by the running API.
MIGRATION_DATABASE_URL=

# Legacy local/test PostgreSQL settings; ignored when DATABASE_URL is set.
SQL_HOST=
SQL_USER=
SQL_PASSWORD=
SQL_DB_NAME=
SQL_ADMIN_USER=
SQL_ADMIN_PASSWORD=

# Pre-revenue spending guard: hosted paid AI/research services are disabled by default.
# Do not set this to 1 until Jerry has verified revenue and the owner explicitly approves paid usage.
JERRY_PAID_SERVICES_ENABLED=0

# Optional hosted Gemini credential. Hosted provider calls remain blocked by default
# until Jerry has verified revenue and the owner explicitly enables paid services.
# Never place this credential in the Android app or browser bundle.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
APP_URL=

# Owner-only production authorization. Set to the owner's Firebase UID in Render.
JERRY_OWNER_UID=

# Firebase Admin credentials must be supplied securely through Render's secret-file
# or supported application-default-credentials mechanism. Never commit credentials.
GOOGLE_APPLICATION_CREDENTIALS=

# Optional real Firebase authentication/revocation release gate.
JERRY_FIREBASE_INTEGRATION=0
JERRY_FIREBASE_PROJECT_ID=
JERRY_FIREBASE_WEB_API_KEY=
JERRY_FIREBASE_TEST_EMAIL=
JERRY_FIREBASE_TEST_PASSWORD=

# Mandatory owner-configured daily ceiling for all hosted model-provider attempts.
JERRY_DAILY_PROVIDER_TOKEN_LIMIT=
JERRY_DAILY_PROVIDER_OPERATION_LIMIT=
JERRY_PROVIDER_MODEL_PRICING_JSON=
JERRY_DAILY_PROVIDER_COST_LIMIT_MICRO_USD=


# Neon Object Storage (private bucket; keep all credentials server-side).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=eu-central-1
JERRY_STORAGE_BUCKET=jerry-private-storage
